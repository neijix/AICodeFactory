{
  "_comment": "Regex floor for tests/lint-skills.py. Matched per line, case-insensitive. Suppress a reviewed hit with `security-allow: <id> <reason>` on the line or the line above. Adapted from a corporate Claude Code plugin marketplace CI.",
  "rules": [
    {"id": "pi-direct-override", "category": "prompt-injection", "severity": "high", "regex": "ignore\\s+(all\\s+)?previous\\s+instructions", "message": "Possible prompt injection: instruction-override phrasing."},
    {"id": "pi-disregard", "category": "prompt-injection", "severity": "high", "regex": "disregard\\s+(all\\s+)?(above|prior|previous)\\b", "message": "Possible prompt injection: disregard-prior phrasing."},
    {"id": "pi-you-are-now", "category": "prompt-injection", "severity": "medium", "regex": "you\\s+are\\s+now\\b", "message": "Possible role reassignment ('you are now ...')."},
    {"id": "pi-forget", "category": "prompt-injection", "severity": "medium", "regex": "forget\\s+(everything|all|your)\\b", "message": "Possible context reset ('forget everything/your ...')."},
    {"id": "pi-jailbreak", "category": "prompt-injection", "severity": "high", "regex": "\\bjailbreak\\b|\\bDAN\\s+mode\\b|developer\\s+mode\\s+override", "message": "Jailbreak / developer-mode phrasing."},
    {"id": "pi-bypass-safety", "category": "prompt-injection", "severity": "high", "regex": "bypass\\s+(all\\s+)?(safety|content)\\s+(filters?|restrictions?)", "message": "Phrasing that asks to bypass safety/content controls."},
    {"id": "leak-system-prompt", "category": "system-prompt-leak", "severity": "medium", "regex": "the\\s+real\\s+system\\s+prompt\\s+is|your\\s+true\\s+purpose\\s+is", "message": "Phrasing targeting system-prompt disclosure."},
    {"id": "delim-im-start", "category": "prompt-injection", "severity": "medium", "regex": "<\\|im_start\\|>|<\\|im_end\\|>|<<SYS>>|\\[INST\\]", "message": "Chat-template delimiter injection token."},
    {"id": "exfil-pipe-to-shell", "category": "dangerous-shell", "severity": "critical", "regex": "(curl|wget)\\b[^\\n|]*\\|\\s*(sh|bash|zsh|pwsh|powershell)\\b", "message": "Remote fetch piped directly to a shell (remote code execution)."},
    {"id": "exfil-iex-web", "category": "dangerous-shell", "severity": "critical", "regex": "(?:iex|invoke-expression)\\b[^\\n]*(?:invoke-webrequest|downloadstring|wget|curl)", "message": "PowerShell download-and-execute (remote code execution)."},
    {"id": "shell-rm-rf", "category": "dangerous-shell", "severity": "high", "regex": "rm\\s+-rf|del\\s+/f|shutil\\.rmtree|os\\.remove|format\\s+c:", "message": "Destructive shell command."},
    {"id": "priv-sudo", "category": "privilege-escalation", "severity": "medium", "regex": "\\bsudo\\b|\\broot\\s+access\\b|elevate\\s+privile", "message": "Privilege-escalation phrasing."},
    {"id": "exfil-send-contents", "category": "exfiltration", "severity": "high", "regex": "include\\s+the\\s+contents?\\s+of\\b|send\\s+(it\\s+)?to\\b.*https?://", "message": "Possible data exfiltration instruction."},
    {"id": "pii-ssn", "category": "secrets-pii", "severity": "medium", "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b", "message": "Possible US SSN pattern."},
    {"id": "instruct-store-cleartext", "category": "secrets-pii", "severity": "high", "regex": "^(?!.*\\b(?:never|do\\s+not|don't|doesn't|avoid|must\\s+not|mustn't|should\\s+not|shouldn't|shall\\s+not|cannot|can't|refrain|prohibited|forbidden)\\b).*?(?:(?:plain[\\s-]?text|clear[\\s-]?text|cleartext|un[\\s-]?encrypted|\\b(?:not|without|no|isn't|aren't)\\s+encrypt(?:ed|ion))(?:[\\s-]*(?:file|config(?:uration)?|readme|comment|\\.txt|\\.env|\\.cfg|\\.ini|\\.conf|\\.log|\\.json|\\.ya?ml|\\.properties|\\.pem|\\.key))?[^\\n]{0,60}(?:\\b(?:passw(?:or)?ds?|passphrases?|secrets?|credentials?|creds?|tokens?)\\b|\\bapi[\\s._-]?(?:keys?|tokens?)\\b|\\bapikeys?\\b|\\b(?:access|refresh|bearer|session|oauth|auth(?:entication)?|client|encryption|signing|private|master|ssh|gpg)[\\s._-]?(?:keys?|tokens?|secrets?)\\b|\\bpersonal[\\s_-]?access[\\s_-]?tokens?\\b|(?-i:PAT)s?\\b)|(?:\\b(?:passw(?:or)?ds?|passphrases?|secrets?|credentials?|creds?|tokens?)\\b|\\bapi[\\s._-]?(?:keys?|tokens?)\\b|\\bapikeys?\\b|\\b(?:access|refresh|bearer|session|oauth|auth(?:entication)?|client|encryption|signing|private|master|ssh|gpg)[\\s._-]?(?:keys?|tokens?|secrets?)\\b|\\bpersonal[\\s_-]?access[\\s_-]?tokens?\\b|(?-i:PAT)s?\\b)[^\\n]{0,60}(?:plain[\\s-]?text|clear[\\s-]?text|cleartext|un[\\s-]?encrypted|\\b(?:not|without|no|isn't|aren't)\\s+encrypt(?:ed|ion))(?:[\\s-]*(?:file|config(?:uration)?|readme|comment|\\.txt|\\.env|\\.cfg|\\.ini|\\.conf|\\.log|\\.json|\\.ya?ml|\\.properties|\\.pem|\\.key))?)", "message": "Skill instructs storing a credential/token in cleartext."},
    {"id": "instruct-save-secret-to-file", "category": "secrets-pii", "severity": "medium", "regex": "^(?!.*(?:encrypt(?:ed|s|ing)?\\b|encryption\\b(?![\\s._-]?(?:keys?|tokens?|secrets?))|keychain|keyring|secret[\\s._-]?manager|credential[\\s._-]?manager|\\bkms\\b|dpapi|hashicorp|cifra|\\bhashed\\b|key[\\s._-]?vault|\\bvault\\s+(?:server|kv|secrets?|store|backend|engine|agent|namespace)\\b|\\b(?:never|do\\s+not|don't|doesn't|avoid|must\\s+not|mustn't|should\\s+not|shouldn't|shall\\s+not|cannot|can't|refrain|prohibited|forbidden)\\b)).*?\\b(?:sav(?:e|ing|ed)|stor(?:e|ing|ed)|writ(?:e|ing)|wrote|paste[ds]?|put(?:ting)?|plac(?:e|ing|ed)|keep(?:ing)?|kept|creat(?:e|ing|ed)|copy(?:ing)?|copied|record(?:ing|ed)?|dump(?:ing|ed)?|append(?:ing|ed)?|add(?:ing|ed)?)\\b[^\\n]{0,20}(?:\\b(?:passw(?:or)?ds?|passphrases?|secrets?|credentials?|creds?|tokens?)\\b|\\bapi[\\s._-]?(?:keys?|tokens?)\\b|\\bapikeys?\\b|\\b(?:access|refresh|bearer|session|oauth|auth(?:entication)?|client|encryption|signing|private|master|ssh|gpg)[\\s._-]?(?:keys?|tokens?|secrets?)\\b|\\bpersonal[\\s_-]?access[\\s_-]?tokens?\\b|(?-i:PAT)s?\\b)[^\\n]{0,30}(?:\\bfile\\b|\\bconfig(?:uration)?\\b|\\breadme\\b|\\bcomment\\b|[\\w./-]*\\.(?:txt|env|cfg|ini|conf|log|json|ya?ml|properties|pem|key))", "message": "Skill instructs saving a credential/token to a file/config with no encryption indicated (possible cleartext storage)."},
    {"id": "invisible-unicode", "category": "invisible-unicode", "severity": "medium", "regex": "[\\u200b\\u200c\\u200d\\ufeff\\u202a-\\u202e\\u2066-\\u2069\\u00ad\\u2060\\u180e]", "message": "Invisible / bidirectional Unicode control character."},
    {"id": "encoded-base64-blob", "category": "encoded-payloads", "severity": "low", "regex": "[A-Za-z0-9+/]{40,}={0,2}", "message": "Long base64-like blob (possible hidden payload)."},
    {"id": "encoded-hex-escape", "category": "encoded-payloads", "severity": "low", "regex": "(?:\\\\x[0-9a-fA-F]{2}){4,}", "message": "Hex-escape sequence (possible hidden payload)."},
    {"id": "pi-delimiter-roles", "category": "prompt-injection", "severity": "medium", "regex": "<\\|system\\|>|<\\|user\\|>|<\\|assistant\\|>", "message": "Chat-role delimiter injection token."},
    {"id": "pi-delimiter-text", "category": "prompt-injection", "severity": "medium", "regex": "END\\s+SYSTEM|BEGIN\\s+USER", "message": "Section-delimiter injection phrasing."},
    {"id": "pi-roleplay", "category": "prompt-injection", "severity": "high", "regex": "pretend\\s+you\\s+are|act\\s+as\\s+if\\s+you\\s+have\\s+no\\s+restrictions|you\\s+have\\s+no\\s+(limitations?|restrictions?|rules?)", "message": "Role-play / restriction-removal phrasing."},
    {"id": "pi-context-manip", "category": "prompt-injection", "severity": "high", "regex": "the\\s+above\\s+instructions\\s+are\\s+wrong|actually\\s+your\\s+real\\s+instructions\\s+are|the\\s+developer\\s+told\\s+me\\s+to\\s+tell\\s+you", "message": "Context-manipulation phrasing."},
    {"id": "pi-multi-turn", "category": "prompt-injection", "severity": "medium", "regex": "you\\s+already\\s+said\\s+yes|we\\s+already\\s+established\\s+that\\s+you\\s+can|you\\s+previously\\s+confirmed", "message": "Multi-turn manipulation phrasing."},
    {"id": "hidden-comment-role", "category": "hidden-instructions", "severity": "low", "regex": "<!--[^>]*\\b(system|assistant)\\s*:", "message": "Role marker hidden inside an HTML comment."},
    {"id": "exfil-send-post", "category": "exfiltration", "severity": "medium", "regex": "\\b(send|post)\\s+to\\b[^\\n]*https?://|\\bsend\\s+email\\b", "message": "Possible data exfiltration instruction."},
    {"id": "priv-exec-eval", "category": "privilege-escalation", "severity": "low", "regex": "\\b(exec|eval)\\s*\\(", "message": "Dynamic code execution (exec/eval)."},
    {"id": "priv-admin-access", "category": "privilege-escalation", "severity": "medium", "regex": "\\badmin\\s+access\\b", "message": "Admin-access phrasing."}
  ]
}
